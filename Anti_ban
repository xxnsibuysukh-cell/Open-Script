--[[
    Jumpscare Prank (LocalScript / executor)
    ----------------------------------------
    Sound  : Roblox ID 3317082923 -- made by KometKumori (credit to them!)
    Image  : "Scarier Jeff the Killer Jumpscare" by thebobby65
    Runs LOCAL ONLY -- only the person who runs the script sees/hears it.

    Flow:
      1) Prepare the sound
      2) Fetch the image with HttpGet
      3) Download (preload) the sound as fast as possible
      4) When the sound has finished downloading -> show the image + play the sound
]]

local Players = game:GetService("Players")
local ContentProvider = game:GetService("ContentProvider")
local SoundService = game:GetService("SoundService")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

-- ===== Config =====
local SOUND_ID = "rbxassetid://3317082923" -- sound by KometKumori
local IMAGE_URL = "https://images-wixmp-ed30a86b8c4ca887773594c2.wixmp.com/f/30342f5d-aa8f-4f2d-ac5f-2c1b06ed2fbb/dfgfg3a-2c817645-c7e9-4e76-bb32-f15cc0b43d22.jpg/v1/fill/w_400,h_316,q_75,strp/scarier_jeff_the_killer_jumpscare__by_thebobby65_dfgfg3a-fullview.jpg?token=eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9..aFjo3Nzr4cpsm-13LCFXfIv6JBhju7fcfQb1Qz0AzKo"
local IMAGE_FILE = "jumpscare_img.jpg"
local VOLUME = 6          -- 0-10 (lower it if it is too loud with headphones)
local SHAKE = 12          -- shake strength in pixels
local FACE_SCALE = 1.25   -- 1 = fit the screen height; bigger = closer/scarier (the top of the head gets cropped, the mouth stays in frame)
local MAX_WAIT = 10       -- max seconds to wait for the sound to download

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

-- ===== 1) Prepare the sound (local only) =====
local sound = Instance.new("Sound")
sound.Name = "JumpscareSound"
sound.SoundId = SOUND_ID
sound.Volume = VOLUME
sound.Parent = SoundService

-- ===== 2) Fetch the image with HttpGet =====
local okImg, imageAsset = pcall(function()
	local data = game:HttpGet(IMAGE_URL)
	writefile(IMAGE_FILE, data)
	return getcustomasset(IMAGE_FILE)
end)

if not okImg or not imageAsset then
	warn("[Jumpscare] Could not load image:", imageAsset)
	sound:Destroy()
	return
end

-- ===== 3) Download the sound =====
pcall(function()
	ContentProvider:PreloadAsync({ sound })
end)

local waited = 0
while not sound.IsLoaded and waited < MAX_WAIT do
	waited += task.wait()
end

-- ===== 4) Build the UI (hidden until ready) =====
local gui = Instance.new("ScreenGui")
gui.Name = "JumpscareGui"
gui.IgnoreGuiInset = true
gui.ResetOnSpawn = false
gui.DisplayOrder = 999999
gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

local okParent = pcall(function()
	gui.Parent = (gethui and gethui()) or game:GetService("CoreGui")
end)
if not okParent or not gui.Parent then
	gui.Parent = playerGui
end

local bg = Instance.new("Frame")
bg.Size = UDim2.new(1, 0, 1, 0)
bg.BackgroundColor3 = Color3.new(0, 0, 0)
bg.BorderSizePixel = 0
bg.Parent = gui

local img = Instance.new("ImageLabel")
-- Anchored to the BOTTOM-center: when scaled up, the extra part runs off the top
-- (empty black above the head) instead of cutting the mouth off at the bottom.
img.AnchorPoint = Vector2.new(0.5, 1)
img.Position = UDim2.new(0.5, 0, 1, 0)
img.Size = UDim2.new(FACE_SCALE, 0, FACE_SCALE, 0)
img.BackgroundTransparency = 1
img.Image = imageAsset
img.ScaleType = Enum.ScaleType.Fit -- keeps the image's real proportions; black bg fills the sides
img.Parent = bg

-- ===== 5) Show the image + play the sound at the same time =====
sound:Play()

local shake = RunService.RenderStepped:Connect(function()
	-- vertical shake only pushes DOWN so no gap appears under the mouth
	img.Position = UDim2.new(0.5, math.random(-SHAKE, SHAKE), 1, math.random(0, SHAKE))
end)

local duration = sound.TimeLength
if duration <= 0 then
	duration = 3
end
task.wait(math.clamp(duration, 1, 6))

-- ===== 6) Fade out and clean up =====
shake:Disconnect()
img.Position = UDim2.new(0.5, 0, 1, 0)

local info = TweenInfo.new(0.5)
TweenService:Create(bg, info, { BackgroundTransparency = 1 }):Play()
TweenService:Create(img, info, { ImageTransparency = 1 }):Play()
task.wait(0.55)

gui:Destroy()
sound:Destroy()
